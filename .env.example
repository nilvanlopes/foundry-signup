PORT=8787
PUBLIC_BASE_URL=https://signup.example.com
AUTHENTIK_BASE_URL=https://authentik.example.com
AUTHENTIK_API_TOKEN=replace-with-limited-service-token
AUTHENTIK_INVITE_FLOW_SLUG=foundry-enrollment
AUTHENTIK_FOUNDRY_GROUP_NAME=foundry-users
AUTHENTIK_FOUNDRY_USER_PATH=users/foundry
AUTHENTIK_FOUNDRY_APP_URL=https://foundry.example.com

# Optional, used by the Google registration callback implemented by this app.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://signup.example.com/api/oauth/google/callback
AUTHENTIK_GOOGLE_SOURCE_SLUG=google
SESSION_SECRET=replace-with-32-byte-random-string
